# Copy to .env and adjust.

# --- Database ---------------------------------------------------------------
# SQLite is the zero-setup fallback (relative path is anchored to the project root).
DATABASE_URL=sqlite:///./wms.db
#
# MySQL (the target backend):
# DATABASE_URL=mysql+pymysql://wms:wms_password@localhost:3306/mineazy_wms
#
# A hosted MySQL that requires TLS (e.g. Aiven's free tier) also needs its CA
# certificate - download it from the provider's dashboard and point this at it:
# DB_SSL_CA=/etc/secrets/ca.pem

DEBUG=false

# Web session cookie signing key - set a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# --- Analytics / forecasting ---------------------------------------------------
SALES_HISTORY_DAYS=90
SERVICE_LEVEL=0.95
LEAD_TIME_DAYS=7
REVIEW_PERIOD_DAYS=7

# Generated Excel / CSV / PNG output (relative -> project root)
OUTPUT_DIR=./output
