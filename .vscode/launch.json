{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Seed database",
      "type": "debugpy",
      "request": "launch",
      "module": "wms.scripts.seed",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "API server (uvicorn --reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["wms.api.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Console (interactive)",
      "type": "debugpy",
      "request": "launch",
      "module": "wms.console",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Console (--demo)",
      "type": "debugpy",
      "request": "launch",
      "module": "wms.console",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
